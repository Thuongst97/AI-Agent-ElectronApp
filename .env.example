# GitHub Copilot / OpenAI-compatible token
GITHUB_TOKEN=ghp_your_token_here

# LLM endpoint (GitHub Models inference endpoint)
LLM_BASE_URL=https://models.inference.ai.azure.com
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2

# ChromaDB (local server — optional; falls back to Vectra if unavailable)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# App
LOG_LEVEL=info
